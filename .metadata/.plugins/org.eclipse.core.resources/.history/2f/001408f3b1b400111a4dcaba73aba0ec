# =========================================================
# SCHOLARSPHERE API GATEWAY
# =========================================================

spring.application.name=API-GATEWAY

server.port=8000


# =========================================================
# EUREKA CONFIGURATION
# =========================================================

eureka.client.service-url.defaultZone=http://localhost:8761/eureka/

eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true

eureka.instance.prefer-ip-address=true


# =========================================================
# SPRING CLOUD GATEWAY
# =========================================================

spring.cloud.gateway.discovery.locator.enabled=false


# =========================================================
# AUTH SERVICE
# =========================================================

spring.cloud.gateway.routes[0].id=AUTH-SERVICE

spring.cloud.gateway.routes[0].uri=lb://AUTH-SERVICE

spring.cloud.gateway.routes[0].predicates[0]=Path=/auth/**


# =========================================================
# CONTENT SERVICE
# =========================================================

spring.cloud.gateway.routes[1].id=CONTENT-SERVICE

spring.cloud.gateway.routes[1].uri=lb://CONTENT-SERVICE

spring.cloud.gateway.routes[1].predicates[0]=Path=/content/**


# =========================================================
# AUTHOR API
# =========================================================

spring.cloud.gateway.routes[2].id=CONTENT-AUTHORS

spring.cloud.gateway.routes[2].uri=lb://CONTENT-SERVICE

spring.cloud.gateway.routes[2].predicates[0]=Path=/authors/**


# =========================================================
# CATEGORY API
# =========================================================

spring.cloud.gateway.routes[3].id=CONTENT-CATEGORIES

spring.cloud.gateway.routes[3].uri=lb://CONTENT-SERVICE

spring.cloud.gateway.routes[3].predicates[0]=Path=/categories/**


# =========================================================
# ENTITLEMENT SERVICE
# =========================================================

spring.cloud.gateway.routes[4].id=ENTITLEMENT-SERVICE

spring.cloud.gateway.routes[4].uri=lb://ENTITLEMENT-SERVICE

spring.cloud.gateway.routes[4].predicates[0]=Path=/entitlements/**


# =========================================================
# SUBSCRIPTION PLANS
# =========================================================

spring.cloud.gateway.routes[5].id=SUBSCRIPTION-PLANS

spring.cloud.gateway.routes[5].uri=lb://ENTITLEMENT-SERVICE

spring.cloud.gateway.routes[5].predicates[0]=Path=/plans/**


# =========================================================
# SUBSCRIPTIONS
# =========================================================

spring.cloud.gateway.routes[6].id=SUBSCRIPTIONS

spring.cloud.gateway.routes[6].uri=lb://ENTITLEMENT-SERVICE

spring.cloud.gateway.routes[6].predicates[0]=Path=/subscriptions/**


# =========================================================
# USAGE SERVICE
# =========================================================

spring.cloud.gateway.routes[7].id=USAGE-SERVICE

spring.cloud.gateway.routes[7].uri=lb://USAGE-SERVICE

spring.cloud.gateway.routes[7].predicates[0]=Path=/usage/**


# =========================================================
# ACTUATOR
# =========================================================

management.endpoints.web.exposure.include=health,info,gateway

management.endpoint.health.show-details=always